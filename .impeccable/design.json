      "css": ".ds-key{position:relative;display:inline-flex;align-items:center;justify-content:center;min-width:96px;min-height:58px;border:0;border-radius:7px;background:#f1eee7;color:#1e2124;font-family:'Martian Mono',monospace;font-size:11px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;box-shadow:inset 0 -3px 0 #bcb5a7,inset 0 1px 0 rgba(255,255,255,.6),0 1px 1px rgba(0,0,0,.25),0 4px 8px -3px rgba(0,0,0,.35);transition:transform 90ms,box-shadow 90ms}.ds-key:hover{background:#f8f6f1}.ds-key:active,.ds-key.is-active{transform:translateY(2px);box-shadow:inset 0 -1px 0 #bcb5a7,0 1px 2px -1px rgba(0,0,0,.3)}.ds-key.is-active{font-weight:700}.ds-key:focus-visible{outline:2px solid #b54700;outline-offset:2px}.ds-led{position:absolute;top:7px;right:8px;width:6px;height:6px;border-radius:999px;background:#9d978b}.ds-key.is-active .ds-led{background:#ffb020;box-shadow:0 0 6px 1px rgba(255,176,32,.75)}"
