      "description": "The single orange action: Convert to Diagram.",
      "html": "<button class=\"ds-commit\"><span>Convert to Diagram</span><kbd class=\"ds-kbd\">Cmd+Enter</kbd></button>",
      "css": ".ds-commit{display:flex;width:320px;align-items:center;justify-content:space-between;min-height:54px;padding:0 16px;border:0;border-radius:9px;background:#ff6a00;color:#1a0e05;font-family:'Martian Mono',monospace;font-size:12px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;box-shadow:inset 0 -4px 0 #b84800,inset 0 1px 0 rgba(255,220,190,.6),0 1px 1px rgba(0,0,0,.3),0 8px 16px -6px rgba(160,60,0,.55);transition:transform 90ms,box-shadow 90ms}.ds-commit:hover{background:#ff7a1a}.ds-commit:active{transform:translateY(3px);background:#e85f00;box-shadow:inset 0 -1px 0 #b84800,0 2px 4px -2px rgba(160,60,0,.5)}.ds-commit:focus-visible{outline:2px solid #b54700;outline-offset:2px}.ds-kbd{font-size:10px;padding:3px 6px;border-radius:4px;background:rgba(26,14,5,.12);text-transform:none}"
    },
