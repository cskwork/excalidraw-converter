  "narrative": {
    "northStar": "The desk instrument that plots onto paper",
    "overview": "The input panel is a small hardware instrument parked beside the Excalidraw canvas. Mode keys pick what you feed it, an amber status window reports what it is doing in plain words, and one safety-orange key commits. The canvas stays Excalidraw's own paper: the instrument never draws on it, it only places a diagram there.",
    "keyCharacteristics": [
      "Real controls rendered as keycaps: flat tops, a shaded skirt, 2-3px of travel on press.",
      "Exactly one orange element on screen, and it is the action that commits.",
      "State is always named in words (IDLE, READY, WORKING, PLOTTED, FAULT), never by color alone.",
      "Wide mono legends for labels and readouts; a quiet grotesk for anything a person reads as prose."
    ],
    "rules": [
      {
        "name": "The One Orange Key Rule",
        "body": "Safety Orange appears on one control, the commit key. When Convert is disabled it turns into an ordinary key; orange never marks something you cannot press.",
        "section": "colors"
      },
      {
        "name": "The Words Not Lights Rule",
        "body": "Every state the LED or window shows is also written out, so color is never the only signal.",
        "section": "colors"
      },
      {
        "name": "The Legends Are Measurements Rule",
        "body": "Mono is used for labels, codes and numbers only. Sentences are always set in Hanken Grotesk.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep every control a real button, tab or separator with keyboard support; the keycap look is a skin on standard affordances.",
      "Do name state in words in the status window whenever something changes.",
      "Do keep the orange for the single commit action.",
      "Do keep Excalidraw's own editor UI untouched."
    ],
    "donts": [
      "Don't add a second orange element or use orange for decoration.",
      "Don't set sentences in Martian Mono.",
      "Don't put kickers or eyebrow labels above headings.",
      "Don't add glow halos beyond the small mode LED."
    ]
  }
